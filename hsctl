#!/usr/bin/env bash
set -euo pipefail

HSCTL_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export HSCTL_ROOT
HSCTL_REPO_ROOT="${HSCTL_REPO_ROOT:-$HOME/Repos/homescale}"
export HSCTL_REPO_ROOT

usage() {
    echo "Usage: hsctl <command> [subcommand] [args...]"
    echo ""
    echo "Commands:"
    for f in "$HSCTL_ROOT/hsctl.d/"*.sh; do
        [[ "$(basename "$f")" == _* ]] && continue
        echo "  $(basename "$f" .sh)"
    done
    exit 1
}

hsctl_install_deps() {
    command -v brew &>/dev/null || {
        echo "hsctl: Homebrew is required to install dependencies — see https://brew.sh" >&2
        exit 1
    }

    local req_file="$HSCTL_ROOT/hsctl.d/requirements.txt"
    [[ -f "$req_file" ]] || { echo "hsctl: missing $req_file" >&2; exit 1; }

    local missing=() pkg bin
    while IFS= read -r pkg; do
        [[ -z "$pkg" || "$pkg" == \#* ]] && continue
        bin="${pkg##*/}"
        command -v "$bin" &>/dev/null || missing+=("$pkg")
    done < "$req_file"

    if [[ ${#missing[@]} -eq 0 ]]; then
        echo "Dependencies already installed."
        return 0
    fi

    echo "Installing missing dependencies via brew: ${missing[*]}"
    brew install "${missing[@]}"
}

hsctl_update() {
    local repo="HomeScaleCloud/homescale"
    local raw_header="Accept: application/vnd.github.raw+json"
    local install_dir="$HOME/.local/bin"
    local modules_dir="$install_dir/hsctl.d"

    mkdir -p "$modules_dir"

    echo "Fetching hsctl..."
    gh api "repos/$repo/contents/hsctl" --header "$raw_header" > "$install_dir/hsctl"
    chmod +x "$install_dir/hsctl"

    echo "Fetching modules..."
    local modules
    modules=$(gh api "repos/$repo/contents/hsctl.d" | grep -o '"name":"[^"]*\.sh"' | cut -d'"' -f4)
    for module in $modules; do
        gh api "repos/$repo/contents/hsctl.d/$module" --header "$raw_header" > "$modules_dir/$module"
        echo "  $module"
    done

    gh api "repos/$repo/contents/hsctl.d/requirements.txt" --header "$raw_header" > "$modules_dir/requirements.txt"

    hsctl_install_deps

    echo "Installed to $install_dir"
}

[[ $# -eq 0 ]] && usage

cmd="$1"; shift

[[ "$cmd" == "--update" ]] && { hsctl_update; exit 0; }

module="$HSCTL_ROOT/hsctl.d/${cmd}.sh"

if [[ ! -f "$module" ]]; then
    echo "hsctl: unknown command '$cmd'" >&2
    usage
fi

# shellcheck source=/dev/null
lib="$HSCTL_ROOT/hsctl.d/_lib.sh"
[[ -f "$lib" ]] && source "$lib"

# shellcheck source=/dev/null
source "$module"
"${cmd}_main" "$@"

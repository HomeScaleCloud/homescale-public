# Patterns to ignore when building Helm packages, and when Helm loads chart
# files (e.g. for .Files.Get). These patterns also gate .Files.Get, so
# plugins/*/dist/main.js and plugins/*/package.json must NOT be excluded
# here — the homescale-theme-plugin-configmap.yaml template reads both at
# render time. Everything else here is plugin dev tooling/source only.
.git/
.gitignore
*.md
plugins/*/node_modules/
plugins/*/src/
plugins/*/*.tar.gz
plugins/*/.vscode/
plugins/*/package-lock.json
plugins/*/tsconfig.json

# Patterns to ignore when building Helm packages, and when Helm loads chart
# files (e.g. for .Files.Get). Only apps/headlamp/plugins/*/dist/ is needed
# at render time — everything else here is plugin dev tooling/source.
.git/
.gitignore
*.md
plugins/*/node_modules/
plugins/*/src/
plugins/*/*.tar.gz
plugins/*/.vscode/
plugins/*/package.json
plugins/*/package-lock.json
plugins/*/tsconfig.json

{
  "extends": [
    "config:recommended",
    "customManagers:githubActionsVersions"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "pin",
        "digest",
        "patch"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "matchPackageNames": [
        "longhorn"
      ],
      "automerge": false,
      "separateMultipleMinor": true
    },
    {
      "matchDepNames": [
        "vultr-kubernetes"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "terraform"
      ],
      "semanticCommitScope": "infra"
    },
    {
      "matchManagers": [
        "argocd",
        "kubernetes",
        "dockerfile"
      ],
      "semanticCommitScope": "apps"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitScope": "deps"
    },
    {
      "enabled": false,
      "matchPackageNames": [
        "/^ghcr\\.io/homescalecloud//"
      ]
    },
    {
      "matchPackageNames": [
        "postfinance/topf",
        "siderolabs/talos",
        "kubernetes/kubernetes"
      ],
      "automerge": false,
      "semanticCommitScope": "infra"
    },
    {
      "description": "kubeconform 0.8.0 regresses JSON output and schema skipping.",
      "matchPackageNames": [
        "yannh/kubeconform"
      ],
      "allowedVersions": "!/^0\\.8\\.0$/"
    }
  ],
  "argocd": {
    "managerFilePatterns": [
      "/apps/.+/[^/]+-argocd\\.yaml$/"
    ]
  },
  "terraform": {
    "managerFilePatterns": [
      "/infra/terraform/.*\\.tf$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/apps/.+/.+\\.yaml$/"
    ]
  },
  "dockerfile": {
    "managerFilePatterns": [
      "/apps/.+/Dockerfile/"
    ]
  },
  "ansible-galaxy": {
    "managerFilePatterns": [
      "/infra/ansible/requirements\\.yml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "matchStrings": [
        "package:\\s*\"(?<depName>[^:]+):(?<currentValue>[^\\s\"]+)\""
      ],
      "datasourceTemplate": "docker",
      "managerFilePatterns": [
        "apps/**/Dockerfile",
        "**/*.compose.yaml"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "apps/**/Dockerfile"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-zA-Z-]+)(?: depName=(?<depName>[^\\s]+))?(?: extractVersion=(?<extractVersion>[^\\s]+))?\\nARG [A-Z_]+=(?<currentValue>[^\\n]+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "apps/cloudflared/values\\.yaml"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-zA-Z-]+)(?: depName=(?<depName>[^\\s]+))?\\n\\s*tag:\\s*\"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        ".github/workflows/deploy\\.yaml"
      ],
      "matchStrings": [
        "pip install ansible kubernetes infisicalsdk==(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "infisicalsdk",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "apps/**/app\\.yaml"
      ],
      "matchStrings": [
        "repoURL:\\s*https://github\\.com/(?<depName>[^\\n\\s]+)\\n\\s+targetRevision:\\s*(?<currentValue>[^\\n\\s]+)"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "infra/terraform/main\\.tf"
      ],
      "matchStrings": [
        "k8s_version\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "vultr-kubernetes",
      "datasourceTemplate": "custom.vultr-k8s",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        ".github/actions/setup-talos/action.yaml"
      ],
      "matchStrings": [
        "topf_version=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "postfinance/topf",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "clusters/**/topf.yaml"
      ],
      "matchStrings": [
        "talosVersion:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "siderolabs/talos",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "clusters/**/topf.yaml"
      ],
      "matchStrings": [
        "kubernetesVersion:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "customDatasources": {
    "vultr-k8s": {
      "defaultRegistryUrlTemplate": "https://api.vultr.com/v2/kubernetes/versions",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": versions.{\"version\": $}}"
      ]
    }
  },
  "platformAutomerge": true
}

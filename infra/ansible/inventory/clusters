#!/usr/bin/env python3
"""Declared clusters remain inventory targets before bootstrap or during outages."""
import json
import os
from pathlib import Path
import sys

root = Path(os.environ.get('HSCTL_REPO_ROOT', Path(__file__).resolve().parents[3]))
hosts = sorted(path.parent.name for path in (root / 'clusters').glob('*/topf.yaml'))
print(json.dumps({} if '--host' in sys.argv else {'clusters': {'hosts': hosts}, '_meta': {'hostvars': {}}}))
